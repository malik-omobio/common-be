  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "health"]
            },
            "description": "Public health endpoint — no auth required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth (Admin)",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const { accessToken, refreshToken } = json.data;",
                  "    if (accessToken) {",
                  "        pm.collectionVariables.set('accessToken', accessToken);",
                  "        console.log('accessToken saved to collection variables');",
                  "    }",
                  "    if (refreshToken) {",
                  "        pm.collectionVariables.set('refreshToken', refreshToken);",
                  "        console.log('refreshToken saved to collection variables');",
                  "    }",
                  "}",
                  "",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Access token returned', () => {",
                  "    pm.expect(pm.response.json().data.accessToken).to.be.a('string');",
                  "});",
                  "pm.test('Refresh token returned', () => {",
                  "    pm.expect(pm.response.json().data.refreshToken).to.be.a('string');",
                  "});",
                  "pm.test('Permissions returned', () => {",
                  "    pm.expect(pm.response.json().data.permissions).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/admin/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "admin", "auth", "login"]
            },
            "description": "Login as admin. Saves `accessToken` and `refreshToken` to collection variables automatically."
          },
          "response": []
        },
        {
          "name": "Admin Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const { accessToken, refreshToken } = json.data;",
                  "    if (accessToken) pm.collectionVariables.set('accessToken', accessToken);",
                  "    if (refreshToken) pm.collectionVariables.set('refreshToken', refreshToken);",
                  "}",
                  "",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('New access token returned', () => {",
                  "    pm.expect(pm.response.json().data.accessToken).to.be.a('string');",
                  "});",
                  "pm.test('New refresh token returned', () => {",
                  "    pm.expect(pm.response.json().data.refreshToken).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/admin/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "admin", "auth", "refresh"]
            },
            "description": "Exchange a valid refresh token for new access and refresh tokens. Uses `refreshToken` from Admin Login."
          },
          "response": []
        },
        {
          "name": "Admin Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "admin", "auth", "logout"]
            },
            "description": "Blacklist current JWT token. Requires Bearer token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Roles (Admin)",
      "item": [
        {
          "name": "Create Role",
          "event": [
